{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-supletivo-net-br",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "admin.supletivo.net.br",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "4791fb0e1704410e92128e1b4b992421"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d13fec466a424ac59c25399ee8628d4a"
    }
  ]
}
