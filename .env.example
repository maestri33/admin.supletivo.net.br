# Variáveis de ambiente — admin.supletivo.net.br (Painel Administrativo / Staff).
#
# Copie este arquivo para `.env.local` (gitignored) e preencha com os
# valores do seu ambiente. O `.env.example` é versionado e serve de documentação;
# o `.env.local` NUNCA é commitado.

# ─── Backend (Django+Ninja) ────────────────────────────────────────────────
#
# URL_BACKEND é server-side only — o browser nunca vê esse valor.
# Aponta para o Django em runtime. Em dev local costuma ser o IP da LXC
# (ex.: http://10.1.20.30) ou um tunnel; em prod é o domínio público
# (ex.: https://api.supletivo.net.br).
URL_BACKEND=https://api.supletivo.net.br

# PUBLIC_API_BASE_URL é exposto ao bundle do browser.
# Vazio = same-origin: o browser chama /api/* no próprio Astro, que reescreve
# para URL_BACKEND no servidor (eliminando CORS e mixed-content).
PUBLIC_API_BASE_URL=

# ─── Build provenance (inlined em /healthz) ────────────────────────────────
GIT_SHA=
BUILD_AT=
