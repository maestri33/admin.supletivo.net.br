---
import pkg from '../../../package.json';
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-brand-ink/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 min-h-[48px] transition hover:opacity-90">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand-green to-brand-blue shadow-md">
          <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display text-base tracking-tight text-white leading-none">
            SUPLETIVO<span class="text-brand-yellow">.NET.BR</span>
          </span>
          <span class="text-[10px] font-bold tracking-widest uppercase text-white/50">
            Painel Administrativo
          </span>
        </div>
      </a>
      <span class="hidden rounded-full bg-brand-yellow/15 px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-brand-yellow border border-brand-yellow/30 sm:inline-block">
        Equipe
      </span>
    </div>

    <div class="flex items-center gap-3">
      <!-- Oracle Version Pill -->
      <a
        href="https://version.v7m.live/api/version"
        target="_blank"
        rel="noopener noreferrer"
        title="Consultar Oráculo de Versão Global da Plataforma"
        class="flex items-center gap-1.5 min-h-[48px] rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[11px] font-mono text-white/70 hover:bg-white/10 hover:text-white transition"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{`v${pkg.version}`}</span>
      </a>

      <!-- Logout Button (Zero-JS fallback + Script) -->
      <button
        id="btn-admin-logout"
        type="button"
        class="hidden items-center gap-1.5 min-h-[48px] rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-500/20 hover:text-white transition"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Sair</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { clearSession, isAuthenticated } from '@/lib/session';

  const logoutBtn = document.getElementById('btn-admin-logout');
  if (logoutBtn) {
    if (isAuthenticated()) {
      logoutBtn.classList.remove('hidden');
      logoutBtn.classList.add('flex');
    }

    logoutBtn.addEventListener('click', () => {
      clearSession();
      window.location.href = '/login';
    });
  }
</script>
