---
import AdminHeader from '../components/layout/AdminHeader.astro';
import AdminNav from '../components/layout/AdminNav.svelte';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  requireAuth?: boolean;
}

const {
  title = "Painel Administrativo — Supletivo Brasil",
  description = "Gestão central de polos, finanças, matrículas e auditoria da plataforma Supletivo Brasil.",
  requireAuth = true,
} = Astro.props;

const pathname = Astro.url.pathname;
const isLoginPage = pathname === '/login';
---

<!doctype html>
<html lang="pt-BR" data-theme="staff">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1220" />

    <!-- Fontes críticas pré-carregadas -->
    <link
      rel="preload"
      href="/fonts/archivo-black-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-dvh flex-col bg-brand-ink text-brand-paper selection:bg-brand-yellow selection:text-brand-ink overflow-x-hidden">
    <!-- Aurora Backdrop Zero-JS -->
    <div class="aurora-wrap pointer-events-none" aria-hidden="true">
      <div class="aurora-layer opacity-40"></div>
    </div>

    <!-- Header -->
    <AdminHeader currentPath={pathname} />

    <!-- Navigation Tabs (Only if not in login page) -->
    {!isLoginPage && <AdminNav client:load currentPath={pathname} />}

    <!-- Main Content Area (Natural fluid scroll) -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 z-10 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
      <slot />
    </main>

    <!-- Footer minimal -->
    <footer class="mt-auto border-t border-white/5 py-4 pb-[calc(1rem+env(safe-area-inset-bottom))] text-center text-xs text-white/40">
      <p>© 2026 Supletivo Brasil • Painel de Controle Soberano • v0.0.0-sandbox.41</p>
    </footer>
  </body>
</html>

<script is:inline define:vars={{ requireAuth, isLoginPage }}>
  // Guard de autenticação no client-side
  if (requireAuth && !isLoginPage) {
    const rawLogin = localStorage.getItem('supletivo.admin.login');
    if (!rawLogin) {
      window.location.href = '/login';
    }
  } else if (isLoginPage) {
    const rawLogin = localStorage.getItem('supletivo.admin.login');
    if (rawLogin) {
      window.location.href = '/';
    }
  }
</script>
